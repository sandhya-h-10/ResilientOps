# Application mode: five independently reasoning Gemini agents.
# Use local explicitly only for offline regression/baseline runs.
RESILIENTOPS_AGENT_MODE=google
RESILIENTOPS_ERP_MODE=local
RESILIENTOPS_KNOWLEDGE_MODE=local
# auto uses Gemini extraction in Google agent mode; rules in local mode.
RESILIENTOPS_EVIDENCE_MODE=gemini
# Use gemini to run substantive extraction with local stage orchestration.
# RESILIENTOPS_EVIDENCE_MODE=gemini
# Optional operator-verified USD prices per 1M tokens. Missing rates show unknown cost.
# RESILIENTOPS_INPUT_USD_PER_MILLION=
# RESILIENTOPS_OUTPUT_USD_PER_MILLION=
# Paths default to this project's resilientops_data and var directories.
# RESILIENTOPS_DB=/absolute/path/to/var/operational.db
# RESILIENTOPS_DATA_DIR=/absolute/path/to/resilientops_data

# Set distinct random tokens or let `resilientops init` create local credentials.
# RESILIENTOPS_MANAGER_TOKEN=
# RESILIENTOPS_SENIOR_TOKEN=

# Google browser sign-in (separate from Gemini/ADK credentials).
# Set all three together. See docs/google-signin.md.
# RESILIENTOPS_GOOGLE_CLIENT_ID=
# RESILIENTOPS_GOOGLE_CLIENT_SECRET=
# RESILIENTOPS_SESSION_SECRET=
# RESILIENTOPS_PUBLIC_URL=http://127.0.0.1:8000

# All agents, extraction and Res use Vertex AI with application default credentials.
RESILIENTOPS_MODEL_BACKEND=vertex
# RESILIENTOPS_AGENT_MODE=google
GOOGLE_CLOUD_PROJECT=project-bceae5b1-7549-4f14-922
GOOGLE_CLOUD_LOCATION=global
RESILIENTOPS_MODEL=gemini-3.5-flash
RESILIENTOPS_LLM_REQUESTS_PER_MINUTE=4
RESILIENTOPS_ANALYSIS_TIMEOUT=1800
RESILIENTOPS_MAX_LLM_CALLS=80

# Optional synthetic ERP import, using tables described in docs/cloud.md.
# RESILIENTOPS_ERP_MODE=bigquery
# RESILIENTOPS_BIGQUERY_DATASET=resilientops_demo

# Optional vector retrieval from an existing deployed index.
# RESILIENTOPS_KNOWLEDGE_MODE=vertex
# RESILIENTOPS_EMBEDDING_MODEL=your-supported-text-embedding-model-id
# RESILIENTOPS_INDEX_ENDPOINT=projects/PROJECT/locations/REGION/indexEndpoints/ENDPOINT
# RESILIENTOPS_DEPLOYED_INDEX_ID=your-deployed-index-id

# Res AI chatbot (independent of the five-agent execution mode).
RESILIENTOPS_CHAT_MODEL=gemini-3.5-flash
# Authenticate on the server: gcloud auth application-default login
# See docs/cloud.md for Vertex setup.


# Cloud SQL PostgreSQL (required on Cloud Run). Supply through Secret Manager.
# Unix socket URL; percent-encode special characters in the username/password.
# RESILIENTOPS_DATABASE_URL=postgresql://USER:PASSWORD@/resilientops?host=/cloudsql/PROJECT:REGION:INSTANCE
# Local development may omit this variable to retain SQLite.
